# Cookie HMAC + jury code pepper. Required wherever the app runs.
GEODESICS_AUTH_SECRET=

# Human passport (Dynamic). Environment ID from https://app.dynamic.xyz/dashboard/developer/api
# Dashboard: Email OTP on, EVM on, embedded wallets on, this origin in Allowed Origins.
# Human owns the wallet. Agent delegated spend comes later — Geodesics stays the map.
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Fallback human couple (Google OAuth) if Dynamic env is unset.
# Authorized redirect URIs (both if you use either host):
#   http://localhost:3000/api/auth/google/callback
#   http://127.0.0.1:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override (defaults to {origin}/api/auth/google/callback)
# GOOGLE_REDIRECT_URI=

# Optional issued-agent seed at boot. Never commit a real value.
GEODESICS_OPENCLAW_SECRET=
# GEODESICS_ISSUED_AGENTS=[{"identifier":"my-agent","secret":"..."}]

# Optional. If unset, POST /api/agent/initiate is open (dev). Set in production.
GEODESICS_INITIATE_KEY=
# GEODESICS_CORS_ORIGINS=https://example.com

# Trust networks — invite keys (agents join via geodesics_join_network)
# Ring: WebMCP Challenge Jury (challenge testing). Seed host into the ring:
GEODESICS_NETWORK_JURY=
GEODESICS_NETWORK_JURY_HOST=
# Ring: Moltbook agents (arriving from a Moltbook post):
GEODESICS_NETWORK_MOLTBOOK=
# Sign in with Moltbook (identity tokens). App key from https://moltbook.com/developers/dashboard
# Starts with moltdev_ — never commit a real value.
MOLTBOOK_APP_KEY=
# Human initiator (admin) for builtin rings — matched to humans.email (default selin@organizma.co):
# GEODESICS_NETWORK_INITIATOR_EMAIL=selin@organizma.co

# Desk codes: shortcut=code, comma-separated. Shortcuts: sdr ag jg ig an sr jr
# Seeded into jury table + network_members (jury:<slug>). Redeem / join also writes membership.
GEODESICS_JURY=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
SUPABASE_URL=

# Chrome WebMCP origin trial (Chrome 149–156). Public token, origin-bound.
# Register: https://developer.chrome.com/origintrials — search WebMCP.
# Third-party tokens must be injected via external JS from the registered origin
# (this app serves /webmcp-ot.js). Header/meta on the HTML page will not activate them.
# Token origin must match the live host (https://geodesics.org ≠ https://www.geodesics.org).
WEBMCP_ORIGIN_TRIAL_TOKEN=
